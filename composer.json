{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "he4rt/100diasdecodigo",
    "type": "project",
    "description": "Platform for 100 Days of Code challenge.",
    "keywords": [
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "basementdevs/filament-webhooks": "^6.0.0",
        "dutchcodingcompany/filament-socialite": "^3.3.0",
        "filament/filament": "^5.10.3",
        "filament/spatie-laravel-media-library-plugin": "^5.10.3",
        "filament/spatie-laravel-tags-plugin": "^5.10.3",
        "he4rt/he4rt-core": ">=1",
        "he4rt/integration-twitter-api": ">=1",
        "he4rt/portal": ">=1",
        "he4rt/submission": ">=1",
        "he4rt/user": ">=1",
        "internachi/modular": "^3.0.2",
        "laravel/framework": "^13.38.0",
        "laravel/sanctum": "^4.3.3",
        "laravel/tinker": "^3.0.2",
        "league/flysystem-sftp-v3": "^3.36",
        "marvinlabs/laravel-discord-logger": "^1.4.4",
        "monicahq/laravel-cloudflare": "^4.1.0",
        "owenvoke/blade-fontawesome": "^3.3.1",
        "socialiteproviders/twitter": "^4.1.2",
        "spatie/laravel-backup": "^10.3.3",
        "tpetry/laravel-postgresql-enhanced": "^3.10.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7.0",
        "fakerphp/faker": "^1.24.1",
        "fruitcake/laravel-debugbar": "^4.4.4",
        "larastan/larastan": "^3.12.2",
        "laravel/boost": "^2.10.1",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.3.3",
        "pestphp/pest-plugin-faker": "^5.0.0",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-livewire": "^5.0.0",
        "pestphp/pest-plugin-phpstan": "^5.2",
        "pestphp/pest-plugin-rector": "^5.0.6",
        "phpstan/extension-installer": "^1.4.3",
        "rector/rector": "^2.6.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "bootstrap/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "He4rt\\IntegrationTwitterApi\\Tests\\": "app-modules/integration-twitter-api/tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade",
            "@php artisan modules:sync --no-phpunit --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"file_exists('.env.testing') || copy('.env.testing.example', '.env.testing');\""
        ],
        "key:generate": [
            "@php artisan key:generate --ansi",
            "@php artisan key:generate --ansi --env=testing"
        ],
        "post-create-project-cmd": [
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "setup": [
            "composer install",
            "npm install",
            "composer run-script post-root-package-install",
            "composer run-script key:generate",
            "composer run-script post-create-project-cmd",
            "@php artisan storage:link --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "pint": "vendor/bin/pint --parallel",
        "test:pint": "vendor/bin/pint --test --parallel",
        "rector": "vendor/bin/rector",
        "test:rector": "vendor/bin/rector --dry-run",
        "phpstan": "vendor/bin/phpstan analyse --ansi",
        "test:phpstan": "vendor/bin/phpstan analyse --ansi",
        "test:unit": "vendor/bin/pest --compact --group=unit",
        "test:feature": "vendor/bin/pest --compact --group=feature",
        "test:arch": "vendor/bin/pest --compact --group=arch",
        "test:cov": "vendor/bin/pest --compact --coverage",
        "check": [
            "@test:rector",
            "@test:pint",
            "@test:phpstan"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "vendor/bin/pest --compact"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "barryvdh/laravel-debugbar"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "bump-after-update": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "policy": {
            "abandoned": {
                "audit": "report"
            },
            "advisories": {
                "block": true
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "app-modules/*",
            "options": {
                "symlink": true
            }
        }
    ]
}
